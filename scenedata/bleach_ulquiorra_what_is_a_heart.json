{"id":"bleach_ulquiorra_what_is_a_heart","lines":[{"t":1.243,"end":2.563,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"Your heart you say?\"","de":"[Ulquiorra] „Dein Herz, sagst du?“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/01.mp3"},{"t":4.191,"end":7.863,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"You humans always toss around that word so casually\"","de":"[Ulquiorra] „Ihr Menschen wirft dieses Wort immer so beiläufig herum“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/02.mp3"},{"t":8.849,"end":11.873,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"As if it's something you can hold in the palm of your hand\"","de":"[Ulquiorra] „Als ob es etwas wäre, das man in der Hand halten könnte“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/03.mp3"},{"t":13.726,"end":16.462,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"But my eyes can see everything\"","de":"[Ulquiorra] „Aber meine Augen können alles sehen“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/04.mp3"},{"t":17.016,"end":19.8,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"Nothing exists that I can't see\"","de":"[Ulquiorra] „Es gibt nichts, was ich nicht sehen kann“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/05.mp3"},{"t":21.431,"end":24.335,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"So if I can't see it, it's not real\"","de":"[Ulquiorra] „Wenn ich es also nicht sehen kann, ist es nicht echt“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/06.mp3"},{"t":25.181,"end":26.645,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"That is what I believe\"","de":"[Ulquiorra] „Das glaube ich“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/07.mp3"},{"t":29.043,"end":31.227,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"Tell me, what is a heart?\"","de":"[Ulquiorra] „Sag mir, was ist ein Herz?“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/08.mp3"},{"t":34.629,"end":38.541,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"If I tore a hole in your chest, would I see it?\"","de":"[Ulquiorra] „Wenn ich ein Loch in deine Brust reißen würde, würde ich es dann sehen?“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/09.mp3"},{"t":39.157,"end":41.869,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"If I split open your skull\"","de":"[Ulquiorra] „Wenn ich dir den Schädel aufspalte“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/10.mp3"},{"t":42.274,"end":43.666,"chars":[0],"who":"Ulquiorra","text":"[Ulquiorra] \"Would it be there?\"","de":"[Ulquiorra] „Wäre es dort?“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/11.mp3"},{"t":43.548,"end":44.652,"chars":[1],"who":"Orihime","text":"[Orihime] \"(Ulquiorra you can NOT say that to someone)\"","de":"[Orihime] „(Ulquiorra, das darfst du NICHT jemandem sagen)“","orig":"scenes/bleach_ulquiorra_what_is_a_heart/lines/12.mp3"}]}