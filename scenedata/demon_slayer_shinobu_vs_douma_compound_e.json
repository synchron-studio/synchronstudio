{"id":"demon_slayer_shinobu_vs_douma_compound_e","lines":[{"t":3.562,"end":7.642,"chars":[0],"who":"Shinobu","text":"This time... I'll increase the dose with multiple strikes!","de":"Dieses Mal ... werde ich die Dosis durch mehrere Schläge erhöhen!","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/01.mp3"},{"t":8.546,"end":11.426,"chars":[0],"who":"Shinobu","text":"Insect breathing, Dance of the Dragonfly","de":"Insektenatmung, Tanz der Libelle","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/02.mp3"},{"t":18.299,"end":20.603,"chars":[0],"who":"Shinobu","text":"Compound Eye Hexagon!","de":"Facettenauge-Sechseck!","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/03.mp3"},{"t":23.435,"end":26.651,"chars":[1],"who":"Douma","text":"I can't believe it... Such blazing speed!","de":"Ich kann es nicht glauben... So eine rasante Geschwindigkeit!","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/04.mp3"},{"t":26.808,"end":30.504,"chars":[1],"who":"Douma","text":"You might be the fastest hashira... I ever met","de":"Du bist vielleicht der schnellste Hashira, den ich je getroffen habe","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/05.mp3"},{"t":32.552,"end":34.28,"chars":[0],"who":"Shinobu","text":"Gasp","de":"Keuch","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/06.mp3"},{"t":34.615,"end":37.111,"chars":[0],"who":"Shinobu","text":"He... got me","de":"Er... hat mich erwischt","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/07.mp3"},{"t":37.007,"end":38.231,"chars":[0],"who":"Shinobu","text":"...","de":"...","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/08.mp3"},{"t":38.271,"end":42.399,"chars":[1],"who":"Douma","text":"Forget the poison, why not try to decapitate me?","de":"Vergiss das Gift, warum versuchst du nicht, mich zu enthaupten?","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/09.mp3"},{"t":43.148,"end":45.284,"chars":[1],"who":"Douma","text":"With your speed you might've won","de":"Mit deiner Geschwindigkeit hättest du vielleicht gewonnen","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/10.mp3"},{"t":46.195,"end":48.403,"chars":[1],"who":"Douma","text":"Ahaha, maybe not","de":"Ahaha, vielleicht auch nicht","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/11.mp3"},{"t":48.423,"end":51.135,"chars":[1],"who":"Douma","text":"I mean, you are small","de":"Ich meine, du bist klein","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/12.mp3"},{"t":51.274,"end":53.146,"chars":[0],"who":"Shinobu","text":"Shaky breathing or something","de":"Zitternde Atmung oder so","orig":"scenes/demon_slayer_shinobu_vs_douma_compound_e/lines/13.mp3"}]}