orra_english_dub/lines/11.mp3"},{"t":44.63,"end":48.504,"chars":[0],"who":"Ulquiorra","text":"(grunting)","de":"(ächzt)","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/12.mp3"},{"t":52.863,"end":57.104,"chars":[0],"who":"Ulquiorra","text":"That was undoubtedly the blast of a Cero","de":"Das war zweifellos ein Cero","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/13.mp3"},{"t":58.604,"end":62.597,"chars":[0],"who":"Ulquiorra","text":"and it was powerful enough to counter my Cero Oscuras","de":"und er war stark genug, um mein Cero Oscuras abzuwehren","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/14.mp3"},{"t":63.755,"end":66.224,"chars":[0],"who":"Ulquiorra","text":"He may resemble a Hollow","de":"Er mag einem Hollow ähneln","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/15.mp3"},{"t":66.33,"end":69.118,"chars":[0],"who":"Ulquiorra","text":"but he can't have the powers","de":"aber er kann unmöglich diese Kräfte haben","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/16.mp3"},{"t":69.236,"end":72.39,"chars":[0],"who":"Ulquiorra","text":"There's no way a human can fire a Cero","de":"Ein Mensch kann unmöglich ein Cero abfeuern","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/17.mp3"},{"t":72.473,"end":73.536,"chars":[0],"who":"Ulquiorra","text":"(gasp)","de":"(keucht)","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/18.mp3"},{"t":76.17,"end":78.036,"chars":[0],"who":"Ulquiorra","text":"That's enough","de":"Das reicht","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/19.mp3"},{"t":85.432,"end":88.704,"chars":[0],"who":"Ulquiorra","text":"It deflected Cero Oscuras a second time","de":"Es hat Cero Oscuras ein zweites Mal abgewehrt","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/20.mp3"},{"t":89.153,"end":91.835,"chars":[0],"who":"Ulquiorra","text":"(gasp)… (gasp)","de":"(keucht) … (keucht)","orig":"scenes/hollow_ichigo_vs_ulquiorra_english_dub/lines/21.mp3"},{"t":9