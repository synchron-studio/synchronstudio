{"id":"blue_lock_isagis_direct_shot","lines":[{"t":1.045,"end":4.789,"chars":[0],"who":"Niko","text":"[Niko] \"Time for Okawa to take the lead and pick up the ball in his own half!\"","de":"[Niko] „Zeit für Okawa, die Führung zu übernehmen und den Ball in seiner eigenen Hälfte zu erobern!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/01.mp3"},{"t":4.288,"end":5.512,"chars":[1],"who":"Okawa","text":"[Okawa] \"(hngh)\"","de":"[Okawa] „(hngh)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/02.mp3"},{"t":4.955,"end":9.155,"chars":[0],"who":"Niko","text":"[Niko] \"And unlike the previous 89 minutes it wont be Okawa going on a solo run!\"","de":"[Niko] „Und im Gegensatz zu den letzten 89 Minuten wird es nicht Okawa sein, der einen Sololauf macht!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/03.mp3"},{"t":9.379,"end":11.443,"chars":[0],"who":"Niko","text":"[Niko] \"In the last 60 seconds\"","de":"[Niko] „In den letzten 60 Sekunden“","orig":"scenes/blue_lock_isagis_direct_shot/lines/04.mp3"},{"t":9.963,"end":10.923,"chars":[2],"who":"Random guy on team Y","text":"[Random guy on team Y] \"huh\"","de":"[Zufälliger Typ im Team Y] „huh“","orig":"scenes/blue_lock_isagis_direct_shot/lines/05.mp3"},{"t":10.626,"end":11.274,"chars":[3],"who":"Gagamaru","text":"[Gagamaru] \"(Little Huh) in the background*\"","de":"[Gagamaru] „(Little Huh) im Hintergrund*“","orig":"scenes/blue_lock_isagis_direct_shot/lines/06.mp3"},{"t":11.642,"end":14.522,"chars":[0],"who":"Niko","text":"[Niko] \"Everyone on team Y joins in on the attack!\"","de":"[Niko] „Jeder im Team Y macht mit beim Angriff!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/07.mp3"},{"t":14.82,"end":17.484,"chars":[0],"who":"Niko","text":"[Niko] \"We call it the one time kill counter\"","de":"[Niko] „Wir nennen es den One-Time-Kill-Counter“","orig":"scenes/blue_lock_isagis_direct_shot/lines/08.mp3"},{"t":17.376,"end":18.768,"chars":[4],"who":"Isagi","text":"[Isagi] \"(gasp)\"","de":"[Isagi] „(keuchen)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/09.mp3"},{"t":21.491,"end":23.699,"chars":[4],"who":"Isagi","text":"[Isagi] \"This is bad he tricked us\"","de":"[Isagi] „Das ist schlimm, er hat uns ausgetrickst“","orig":"scenes/blue_lock_isagis_direct_shot/lines/10.mp3"},{"t":24.364,"end":28.684,"chars":[4],"who":"Isagi","text":"[Isagi] \"We commited too many players to the attack, creating a weakness in our defense!\"","de":"[Isagi] „Wir haben zu viele Spieler im Angriff eingesetzt, was zu einer Schwäche in unserer Verteidigung geführt hat!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/11.mp3"},{"t":29.433,"end":31.617,"chars":[4],"who":"Isagi","text":"[Isagi] \"If they make a goal its over!\"","de":"[Isagi] „Wenn sie ein Tor machen, ist es vorbei!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/12.mp3"},{"t":32.117,"end":33.341,"chars":[4],"who":"Isagi","text":"[Isagi] \"No way...\"","de":"[Isagi] „Auf keinen Fall...“","orig":"scenes/blue_lock_isagis_direct_shot/lines/13.mp3"},{"t":34.237,"end":38.197,"chars":[4],"who":"Isagi","text":"[Isagi] \"I won't let this happen!\"","de":"[Isagi] „Das werde ich nicht zulassen!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/14.mp3"},{"t":40.436,"end":42.596,"chars":[5],"who":"Raichi","text":"[Raichi] \"You Serious? We're so dead\"","de":"[Raichi] „Ist das dein Ernst? Wir sind so tot“","orig":"scenes/blue_lock_isagis_direct_shot/lines/15.mp3"},{"t":41.888,"end":44.048,"chars":[6],"who":"Igaguri","text":"[Igaguri] \"Everyone! Get Back!\"","de":"[Igaguri] „Alle! Kommt zurück!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/16.mp3"},{"t":43.831,"end":46.159,"chars":[7],"who":"Random dude on team Z","text":"[Random dude on team Z] \"Not good, someone stop him!\"","de":"[Zufälliger Typ im Team Z] „Nicht gut, jemand hält ihn auf!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/17.mp3"},{"t":46.171,"end":48.139,"chars":[7],"who":"Random dude on team Z","text":"[Random dude on team Z] \"Its up to you, Block him!\"","de":"[Zufälliger Typ im Team Z] „Es liegt an dir, blockiere ihn!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/18.mp3"},{"t":46.722,"end":47.874,"chars":[8],"who":"Chigiri","text":"[Chigiri] \"(hmph)\"","de":"[Chigiri] „(hmph)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/19.mp3"},{"t":52.692,"end":56.196,"chars":[9],"who":"Lemon","text":"[Lemon] \"Its one on one if i dont save this its over\"","de":"[Lemon] „Es ist eins zu eins, wenn ich das nicht speichere, ist es vorbei.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/20.mp3"},{"t":56.252,"end":58.58,"chars":[9],"who":"Lemon","text":"[Lemon] \"All our soccer careers end here\"","de":"[Lemon] „Alle unsere Fußballkarrieren enden hier“","orig":"scenes/blue_lock_isagis_direct_shot/lines/21.mp3"},{"t":58.699,"end":59.995,"chars":[9],"who":"Lemon","text":"[Lemon] \"Forever!\"","de":"[Zitrone] „Für immer!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/22.mp3"},{"t":60.613,"end":63.637,"chars":[9],"who":"Lemon","text":"[Lemon] \"i have to block his shot no matter what!\"","de":"[Lemon] „Ich muss seinen Schuss abwehren, egal was passiert!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/23.mp3"},{"t":64.221,"end":66.213,"chars":[9],"who":"Lemon","text":"[Lemon] \"(shocked)\"","de":"[Zitrone] „(schockiert)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/24.mp3"},{"t":68.782,"end":70.294,"chars":[9],"who":"Lemon","text":"[Lemon] \"Where'd he come from?\"","de":"[Lemon] „Wo kommt er her?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/25.mp3"},{"t":70.595,"end":71.891,"chars":[9],"who":"Lemon","text":"[Lemon] \"(uhg)\"","de":"[Zitrone] „(uhg)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/26.mp3"},{"t":73.142,"end":77.27,"chars":[10],"who":"Naruhaya","text":"[Naruhaya] \"Its all over.....We're screwed\"","de":"[Naruhaya] „Es ist alles vorbei...Wir sind am Arsch“","orig":"scenes/blue_lock_isagis_direct_shot/lines/27.mp3"},{"t":82.206,"end":83.502,"chars":[1],"who":"Okawa","text":"[Okawa] \"Huh?\"","de":"[Okawa] „Häh?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/28.mp3"},{"t":82.223,"end":83.447,"chars":[9],"who":"Lemon","text":"[Lemon] \"Huh?\"","de":"[Zitrone] „Häh?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/29.mp3"},{"t":86.489,"end":89.609,"chars":[4],"who":"Isagi","text":"[Isagi] \"Here, You and i know this spot right?\"","de":"[Isagi] „Hier, du und ich kennen diesen Ort, oder?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/30.mp3"},{"t":89.849,"end":93.785,"chars":[4],"who":"Isagi","text":"[Isagi] \"Cause its where we belong, The place where you can smell a goal!\"","de":"[Isagi] „Denn es ist der Ort, an dem wir hingehören. Der Ort, an dem man ein Ziel riechen kann!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/31.mp3"},{"t":93.507,"end":94.491,"chars":[0],"who":"Niko","text":"[Niko] \"Huh?\"","de":"[Niko] „Häh?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/32.mp3"},{"t":96.291,"end":100.803,"chars":[4],"who":"Isagi","text":"[Isagi] \"You and i are alike the way we think and how we read the field\"","de":"[Isagi] „Du und ich sind in der Art und Weise, wie wir denken und das Fachgebiet lesen, gleich.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/33.mp3"},{"t":101.122,"end":106.066,"chars":[4],"who":"Isagi","text":"[Isagi] \"Instead of taking the shot yourself you pass to okawa to finish us off\"","de":"[Isagi] „Anstatt selbst den Schuss abzugeben, passt du zu Okawa, um uns zu erledigen.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/34.mp3"},{"t":106.118,"end":111.11,"chars":[4],"who":"Isagi","text":"[Isagi] \"That's why you lost Niko At the last you chose to give up the ball\"","de":"[Isagi] „Deshalb hast du Niko verloren. Letztendlich hast du dich entschieden, den Ball aufzugeben.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/35.mp3"},{"t":111.769,"end":113.761,"chars":[4],"who":"Isagi","text":"[Isagi] \"Which means you're no striker at all!\"","de":"[Isagi] „Das heißt, du bist überhaupt kein Stürmer!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/36.mp3"},{"t":116.316,"end":121.188,"chars":[1],"who":"Okawa","text":"[Okawa] \"Oh shit! Stupid punks are countering Get back! Steal the ball!\"","de":"[Okawa] „Oh Scheiße! Dumme Punks kontern. Geh zurück! Stehle den Ball!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/37.mp3"},{"t":121.296,"end":125.904,"chars":[4],"who":"Isagi","text":"[Isagi] \"I chose Rather then taking the shot i cried when i lost\"","de":"[Isagi] „Ich habe mich entschieden, anstatt zu schießen, habe ich geweint, als ich verloren habe.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/38.mp3"},{"t":126.199,"end":131.383,"chars":[4],"who":"Isagi","text":"[Isagi] \"But that version of myself is a memory i dont need it anymore I WANT TO WIN!\"","de":"[Isagi] „Aber diese Version von mir selbst ist eine Erinnerung, ich brauche sie nicht mehr. ICH WILL GEWINNEN!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/39.mp3"},{"t":133.444,"end":136.084,"chars":[4],"who":"Isagi","text":"[Isagi] \"Now is the time TO BE REBORN!\"","de":"[Isagi] „Jetzt ist die Zeit, WIEDERGEBOREN ZU WERDEN!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/40.mp3"},{"t":136.278,"end":137.574,"chars":[11],"who":"Kunigami","text":"[Kunigami] \"ugh\"","de":"[Kunigami] „pfui“","orig":"scenes/blue_lock_isagis_direct_shot/lines/41.mp3"},{"t":138.594,"end":140.346,"chars":[11],"who":"Kunigami","text":"[Kunigami] \"Nice Pass Isagi\"","de":"[Kunigami] „Nice Pass Isagi“","orig":"scenes/blue_lock_isagis_direct_shot/lines/42.mp3"},{"t":140.579,"end":144.347,"chars":[12],"who":"Random guy on team Y 2","text":"[Random guy on team Y 2] \"(grunts)\"","de":"[Zufälliger Typ im Team Y 2] „(grunzt)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/43.mp3"},{"t":140.6,"end":143.864,"chars":[2],"who":"Random guy on team Y","text":"[Random guy on team Y] \"Foul him if you have to Just stop him!\"","de":"[Zufälliger Typ in Team Y] „Foule ihn, wenn du ihn einfach aufhalten musst!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/44.mp3"},{"t":141.056,"end":146.144,"chars":[11],"who":"Kunigami","text":"[Kunigami] \"(grunting) Damn it! Its up to you!\"","de":"[Kunigami] „(grunzend) Verdammt! Es liegt an dir!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/45.mp3"},{"t":145.643,"end":147.251,"chars":[13],"who":"Bachira","text":"[Bachira] \"Ou!\"","de":"[Bachira] „Ou!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/46.mp3"},{"t":147.449,"end":149.201,"chars":[13],"who":"Bachira","text":"[Bachira] \"I read you loud and clear!\"","de":"[Bachira] „Ich habe dich laut und deutlich gelesen!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/47.mp3"},{"t":148.971,"end":150.291,"chars":[2],"who":"Random guy on team Y","text":"[Random guy on team Y] \"Take him out!\"","de":"[Zufälliger Typ im Team Y] „Schafft ihn raus!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/48.mp3"},{"t":150.794,"end":151.97,"chars":[12],"who":"Random guy on team Y 2","text":"[Random guy on team Y 2] \"(falling noise)\"","de":"[Zufälliger Typ im Team Y 2] „(fallendes Geräusch)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/49.mp3"},{"t":152.598,"end":155.91,"chars":[2],"who":"Random guy on team Y","text":"[Random guy on team Y] \"(grunts then fall)\"","de":"[Zufälliger Typ aus Team Y] „(grunzt und fällt dann)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/50.mp3"},{"t":154.749,"end":155.445,"chars":[13],"who":"Bachira","text":"[Bachira] \"(little grunt)\"","de":"[Bachira] „(kleines Grunzen)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/51.mp3"},{"t":157.73,"end":159.722,"chars":[13],"who":"Bachira","text":"[Bachira] \"I'll leave the rest to you!\"","de":"[Bachira] „Den Rest überlasse ich dir!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/52.mp3"},{"t":160.004,"end":160.604,"chars":[13],"who":"Bachira","text":"[Bachira] \"(kicking ball noise)\"","de":"[Bachira] „(Trittballgeräusch)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/53.mp3"},{"t":161.76,"end":164.352,"chars":[3],"who":"Gagamaru","text":"[Gagamaru] \"Thats low but okay Ill take it!\"","de":"[Gagamaru] „Das ist niedrig, aber okay, ich nehme es!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/54.mp3"},{"t":164.427,"end":165.963,"chars":[3],"who":"Gagamaru","text":"[Gagamaru] \"Huh? (falls)\"","de":"[Gagamaru] „Huh? (fällt)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/55.mp3"},{"t":165.913,"end":167.809,"chars":[6],"who":"Igaguri","text":"[Igaguri] \"HE MISSED WE'RE DEAD!\"","de":"[Igaguri] „Er hat verpasst, dass wir tot sind!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/56.mp3"},{"t":167.604,"end":170.868,"chars":[13],"who":"Bachira","text":"[Bachira] \"No You didn't notice i was aiming beyond him\"","de":"[Bachira] „Nein, du hast nicht bemerkt, dass ich über ihn hinaus zielte.“","orig":"scenes/blue_lock_isagis_direct_shot/lines/57.mp3"},{"t":172.815,"end":174.375,"chars":[13],"who":"Bachira","text":"[Bachira] \"At number Eleven!\"","de":"[Bachira] „Bei Nummer Elf!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/58.mp3"},{"t":174.881,"end":175.841,"chars":[0],"who":"Niko","text":"[Niko] \"(huh)\"","de":"[Niko] „(huh)“","orig":"scenes/blue_lock_isagis_direct_shot/lines/59.mp3"},{"t":175.824,"end":177.384,"chars":[1],"who":"Okawa","text":"[Okawa] \"He's there? But how?\"","de":"[Okawa] „Er ist da? Aber wie?“","orig":"scenes/blue_lock_isagis_direct_shot/lines/60.mp3"},{"t":177.397,"end":178.621,"chars":[11],"who":"Kunigami","text":"[Kunigami] \"Go!\"","de":"[Kunigami] „Los!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/61.mp3"},{"t":178.718,"end":181.55,"chars":[13],"who":"Bachira","text":"[Bachira] \"Score it You egoist!\"","de":"[Bachira] „Treffer, du Egoist!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/62.mp3"},{"t":182,"end":184.184,"chars":[13],"who":"Bachira","text":"[Bachira] \"Yoichi Isagi!\"","de":"[Bachira] „Yoichi Isagi!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/63.mp3"},{"t":184.473,"end":187.569,"chars":[4],"who":"Isagi","text":"[Isagi] \"I am.... A STRIKER!\"","de":"[Isagi] „Ich bin... EIN STREIKER!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/64.mp3"},{"t":198.134,"end":200.6,"chars":[10],"who":"Naruhaya","text":"[Naruhaya] \"YEAH!!!!!!!!\"","de":"[Naruhaya] „JA!!!!!!!!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/65.mp3"},{"t":198.176,"end":200.6,"chars":[14],"who":"Kuon","text":"[Kuon] \"YEAH!!!\"","de":"[Kuon] „JA!!!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/66.mp3"},{"t":198.176,"end":200.6,"chars":[6],"who":"Igaguri","text":"[Igaguri] \"YEAH!!!\"","de":"[Igaguri] „JA!!!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/67.mp3"},{"t":198.176,"end":200.6,"chars":[7],"who":"Random dude on team Z","text":"[Random dude on team Z] \"YEAH!!!\"","de":"[Zufälliger Typ im Team Z] „YEAH!!!“","orig":"scenes/blue_lock_isagis_direct_shot/lines/68.mp3"}]}