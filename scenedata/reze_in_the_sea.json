{"id":"reze_in_the_sea","lines":[{"t":0.0,"end":3.5,"chars":[1],"who":"Denji","text":"Ahh ah ah *Exhausted Grunts*","de":"Ahh, ah, ah ... (erschöpftes Keuchen)","orig":"scenes/reze_in_the_sea/lines/01.mp3"},{"t":1.972,"end":5.851,"chars":[2],"who":"Reze","text":"Do me a solid and drop dead, You're being a huge pain in the ass","de":"Tu mir einen Gefallen und stirb endlich. Du gehst mir gewaltig auf die Nerven.","orig":"scenes/reze_in_the_sea/lines/02.mp3"},{"t":5.968,"end":8.133,"chars":[1],"who":"Denji","text":"Whos fault is that?!","de":"Und wessen Schuld ist das?!","orig":"scenes/reze_in_the_sea/lines/03.mp3"},{"t":8.166,"end":12.446,"chars":[1],"who":"Denji","text":"*grunt* Wouldnt it have been easier for you to have killed me when we first met?!","de":"(stöhnt) Wär's nicht einfacher gewesen, mich gleich beim ersten Treffen umzubringen?!","orig":"scenes/reze_in_the_sea/lines/04.mp3"},{"t":14.015,"end":16.132,"chars":[2],"who":"Reze","text":"Theres nowhere for you to run","de":"Du kannst nirgendwohin fliehen.","orig":"scenes/reze_in_the_sea/lines/05.mp3"},{"t":16.241,"end":17.795,"chars":[1],"who":"Denji","text":"Sure about that?","de":"Bist du dir sicher?","orig":"scenes/reze_in_the_sea/lines/06.mp3"},{"t":18.234,"end":18.887,"chars":[1],"who":"Denji","text":"*Small chuckle*","de":"(kichert leise)","orig":"scenes/reze_in_the_sea/lines/07.mp3"},{"t":18.972,"end":21.77,"chars":[1],"who":"Denji","text":"Maybe you shouldnt have taught me how to swim","de":"Vielleicht hättest du mir nicht das Schwimmen beibringen sollen.","orig":"scenes/reze_in_the_sea/lines/08.mp3"},{"t":21.909,"end":25.232,"chars":[2],"who":"Reze","text":"Huhhhh thats your escape plan?","de":"Hää? Das ist dein Fluchtplan?","orig":"scenes/reze_in_the_sea/lines/09.mp3"},{"t":45.793,"end":47.511,"chars":[1],"who":"Denji","text":"AHHHHH!","de":"AHHHHH!","orig":"scenes/reze_in_the_sea/lines/10.mp3"},{"t":49.891,"end":52.123,"chars":[1],"who":"Denji","text":"ERGH AUGH","de":"ERGH! AUGH!","orig":"scenes/reze_in_the_sea/lines/11.mp3"},{"t":52.391,"end":53.861,"chars":[1],"who":"Denji","text":"AUGH","de":"AUGH!","orig":"scenes/reze_in_the_sea/lines/12.mp3"},{"t":53.916,"end":55.512,"chars":[2],"who":"Reze","text":"Chains??","de":"Ketten?!","orig":"scenes/reze_in_the_sea/lines/13.mp3"},{"t":55.572,"end":58.499,"chars":[1],"who":"Denji","text":"HUGHHHH UGHHHH","de":"HUGHHHH! UGHHHH!","orig":"scenes/reze_in_the_sea/lines/14.mp3"},{"t":61.862,"end":63.81,"chars":[1],"who":"Denji","text":"GUH AHH GUH","de":"GUH! AHH! GUH!","orig":"scenes/reze_in_the_sea/lines/15.mp3"},{"t":69.614,"end":72.277,"chars":[1],"who":"Denji","text":"UH GAHH UH","de":"UH! GAHH! UH!","orig":"scenes/reze_in_the_sea/lines/16.mp3"},{"t":72.87,"end":75.703,"chars":[1],"who":"Denji","text":"AUGHH SO SMARTASS?!","de":"AUGHH! Na, du Schlaumeierin?!","orig":"scenes/reze_in_the_sea/lines/17.mp3"},{"t":75.728,"end":79.099,"chars":[1],"who":"Denji","text":"YOU THINK YOU CAN STILL EXPLODE WHEN YOU'RE WET?!","de":"GLAUBST DU, DU KANNST NOCH EXPLODIEREN, WENN DU NASS BIST?!","orig":"scenes/reze_in_the_sea/lines/18.mp3"}]}
